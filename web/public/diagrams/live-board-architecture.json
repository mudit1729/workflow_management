  "edges": [
    { "from": "claude", "to": "cli" },
    { "from": "codex", "to": "cli" },
    { "from": "cli", "to": "files", "label": "per-file lock, atomic write" },
    { "from": "hand", "to": "files", "label": "by hand" },
    { "from": "files", "to": "watcher", "label": "file events" },
    { "from": "watcher", "to": "index", "label": "dirty path" },
    { "from": "index", "to": "snapshot", "label": "swap" },
    { "from": "index", "to": "sse", "label": "delta, activity" },
    { "from": "sse", "to": "leader", "label": "SSE" },
    { "from": "leader", "to": "tabs", "label": "BroadcastChannel" },
    { "from": "leader", "to": "cache", "label": "apply delta" },
    { "from": "cache", "to": "board", "label": "render" },
    { "from": "board", "to": "sse", "label": "POST /api/ops" },
    { "from": "sse", "to": "edit", "label": "op" },
    { "from": "edit", "to": "files", "label": "atomic rename" },
    { "from": "edit", "to": "index", "label": "new hash, echo ignored" }
