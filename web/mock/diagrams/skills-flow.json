{
  "meta": { "title": "How the skills fit together" },
  "groups": [
    { "id": "workflow", "label": "workflow" },
    { "id": "library", "label": "library" },
    { "id": "agent-execution", "label": "agent-execution" }
  ],
  "nodes": [
    {
      "id": "hook",
      "label": "SessionStart hook",
      "kind": "start",
      "group": "workflow",
      "note": "Injects wf context for the active issue"
    },
    { "id": "resume", "label": "resume-issue", "kind": "step", "group": "workflow" },
    { "id": "exists", "label": "Issue exists?", "kind": "decision", "group": "workflow" },
    {
      "id": "search",
      "label": "search-library",
      "kind": "step",
      "group": "library",
      "note": "Read only the top 1 or 2 hits"
    },
    { "id": "goal", "label": "write-goal", "kind": "step", "group": "workflow" },
    { "id": "hasplan", "label": "Plan exists?", "kind": "decision", "group": "workflow" },
    { "id": "plan", "label": "write-plan", "kind": "step", "group": "workflow" },
    {
      "id": "split",
      "label": "split-issue",
      "kind": "step",
      "group": "workflow",
      "note": "Over 10 tasks or several deliverables"
    },
    { "id": "claim", "label": "claim-task", "kind": "step", "group": "workflow" },
    {
      "id": "dispatch",
      "label": "dispatch-subagents",
      "kind": "step",
      "group": "agent-execution",
      "note": "For a wide ready set"
    },
    {
      "id": "guidelines",
      "label": "execution-guidelines",
      "kind": "step",
      "group": "agent-execution"
    },
    { "id": "test", "label": "test-first", "kind": "step", "group": "agent-execution" },
    {
      "id": "execute",
      "label": "Execute the task",
      "kind": "step",
      "group": "agent-execution"
    },
    {
      "id": "lean",
      "label": "keep-context-lean",
      "kind": "crosscut",
      "group": "agent-execution",
      "note": "Applies to every step"
    },
    {
      "id": "log",
      "label": "log-change / log-decision",
      "kind": "step",
      "group": "workflow"
    },
    { "id": "stuck", "label": "Stuck?", "kind": "decision", "group": "agent-execution" },
    {
      "id": "debug",
      "label": "debug-systematically",
      "kind": "step",
      "group": "agent-execution"
    },
    {
      "id": "three",
      "label": "Failed 3 times?",
      "kind": "decision",
      "group": "agent-execution"
    },
    {
      "id": "ask",
      "label": "ask-human",
      "kind": "end",
      "group": "workflow",
      "note": "Waits for an answer, then resume-issue"
    },
    {
      "id": "verify",
      "label": "verify-before-done",
      "kind": "step",
      "group": "agent-execution"
    },
    { "id": "state", "label": "write-current-state", "kind": "step", "group": "workflow" },
    { "id": "alldone", "label": "All tasks done?", "kind": "decision", "group": "workflow" },
    {
      "id": "review",
      "label": "review-work",
      "kind": "step",
      "group": "agent-execution",
      "note": "Runs in a fresh context"
    },
    { "id": "close", "label": "close-issue", "kind": "step", "group": "workflow" },
    { "id": "learn", "label": "log-learning", "kind": "step", "group": "workflow" },
    {
      "id": "promote",
      "label": "promote-to-library",
      "kind": "step",
      "group": "library",
      "note": "Creates a draft for review"
    },
    {
      "id": "curate",
      "label": "curate-library",
      "kind": "end",
      "group": "library",
      "note": "Runs now and then"
    }
  ],
  "edges": [
    { "from": "hook", "to": "resume" },
    { "from": "resume", "to": "exists" },
    { "from": "exists", "to": "search", "label": "no" },
    { "from": "search", "to": "goal" },
    { "from": "goal", "to": "hasplan" },
    { "from": "exists", "to": "hasplan", "label": "yes" },
    { "from": "hasplan", "to": "plan", "label": "no" },
    { "from": "hasplan", "to": "claim", "label": "yes" },
    { "from": "plan", "to": "split", "label": "too big" },
    { "from": "plan", "to": "claim", "label": "ready" },
    { "from": "split", "to": "claim", "label": "smaller issues" },
    { "from": "claim", "to": "guidelines" },
    { "from": "claim", "to": "dispatch", "label": "wide ready set" },
    { "from": "guidelines", "to": "test" },
    { "from": "test", "to": "execute" },
    { "from": "dispatch", "to": "execute", "label": "workers claim tasks" },
    { "from": "lean", "to": "execute" },
    { "from": "execute", "to": "log" },
    { "from": "log", "to": "stuck" },
    { "from": "stuck", "to": "debug", "label": "yes" },
    { "from": "stuck", "to": "verify", "label": "no" },
    { "from": "debug", "to": "three" },
    { "from": "three", "to": "ask", "label": "yes" },
    { "from": "three", "to": "execute", "label": "no, try again" },
    { "from": "verify", "to": "state" },
    { "from": "state", "to": "alldone" },
    { "from": "alldone", "to": "claim", "label": "no, next task" },
    { "from": "alldone", "to": "review", "label": "yes" },
    { "from": "review", "to": "close" },
    { "from": "close", "to": "learn" },
    { "from": "learn", "to": "promote" },
    { "from": "promote", "to": "curate" }
  ]
